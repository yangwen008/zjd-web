/* pages/broker/list/list.wxss */
.page { min-height: 100vh; background: #f5f5f5; }

.topbar { background: linear-gradient(135deg, #1a4731, #2d6a4f); padding: 20rpx 30rpx; padding-top: calc(var(--status-bar-height, 44px) + 20rpx); }
.topbar-title { font-size: 34rpx; color: #ffffff; font-weight: bold; }

.filter-bar { display: flex; gap: 12rpx; padding: 16rpx 24rpx; background: #ffffff; border-bottom: 1rpx solid #f0f0f0; flex-wrap: wrap; }
.filter-btn { font-size: 24rpx; padding: 10rpx 20rpx; border-radius: 20rpx; background: #f5f5f5; color: #666; }
.filter-btn.active { background: #1a4731; color: #ffffff; }

.waterfall { display: flex; gap: 16rpx; padding: 20rpx; }
.waterfall-col { flex: 1; display: flex; flex-direction: column; }

.broker-card {
  background: #ffffff; border-radius: 16rpx; overflow: hidden;
  margin-bottom: 16rpx; padding: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.broker-avatar { position: relative; width: 100%; height: 200rpx; border-radius: 12rpx; overflow: hidden; background: #e8f5e9; display: flex; align-items: center; justify-content: center; margin-bottom: 12rpx; }
.avatar-img { width: 100%; height: 100%; }
.avatar-text { font-size: 64rpx; color: #1a4731; font-weight: bold; }
.rating-badge { position: absolute; top: 8rpx; right: 8rpx; font-size: 28rpx; background: rgba(255,255,255,0.9); border-radius: 50%; width: 44rpx; height: 44rpx; display: flex; align-items: center; justify-content: center; }

.broker-name { font-size: 28rpx; font-weight: bold; color: #1a1a1a; display: block; margin-bottom: 4rpx; }
.broker-region { font-size: 22rpx; color: #999; display: block; margin-bottom: 10rpx; }

.broker-stats { display: flex; gap: 16rpx; margin-bottom: 10rpx; }
.stat { font-size: 20rpx; color: #666; }

.broker-tags { display: flex; flex-wrap: wrap; gap: 6rpx; }
.btag { font-size: 18rpx; padding: 2rpx 10rpx; border-radius: 6rpx; background: #e8f5e9; color: #1a4731; }

.loading, .empty { text-align: center; padding: 40rpx; color: #999; font-size: 26rpx; }
.empty-icon { font-size: 60rpx; display: block; margin-bottom: 12rpx; }

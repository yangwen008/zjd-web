/* pages/services/detail/detail.wxss */
.page { min-height: 100vh; background: #f5f5f5; padding-bottom: 120rpx; }

.header { position: relative; padding-bottom: 20rpx; }
.header-bg { position: absolute; top: 0; left: 0; right: 0; height: 200rpx; background: linear-gradient(135deg, #1a4731, #2d6a4f); }
.header-card { position: relative; display: flex; gap: 20rpx; padding: 40rpx 30rpx 20rpx; }
.svc-icon-wrap { width: 100rpx; height: 100rpx; border-radius: 50%; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.svc-icon { font-size: 48rpx; }
.header-info { flex: 1; }
.name-row { display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap; margin-bottom: 8rpx; }
.svc-name { font-size: 34rpx; font-weight: bold; color: #ffffff; }
.verified-badge { font-size: 18rpx; padding: 2rpx 10rpx; border-radius: 10rpx; background: rgba(255,255,255,0.3); color: #ffffff; }
.type-badge { font-size: 18rpx; padding: 2rpx 10rpx; border-radius: 10rpx; background: rgba(255,255,255,0.15); color: rgba(255,255,255,0.9); }
.svc-org { font-size: 24rpx; color: rgba(255,255,255,0.8); display: block; }
.svc-qual { font-size: 22rpx; color: rgba(255,255,255,0.7); display: block; margin-top: 4rpx; }
.svc-license { font-size: 20rpx; color: rgba(255,255,255,0.6); display: block; margin-top: 4rpx; }

.stats-bar { display: flex; background: #ffffff; margin: 0 24rpx; border-radius: 16rpx; padding: 24rpx 0; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); margin-top: -20rpx; position: relative; z-index: 1; }
.stat-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6rpx; border-right: 1rpx solid #f0f0f0; }
.stat-item:last-child { border-right: none; }
.stat-num { font-size: 28rpx; font-weight: bold; color: #1a4731; }
.stat-label { font-size: 20rpx; color: #999; }

.section { background: #ffffff; margin: 20rpx 0; padding: 24rpx; }
.section-title { font-size: 28rpx; font-weight: bold; color: #333; display: block; margin-bottom: 16rpx; }
.section-body { font-size: 26rpx; color: #666; line-height: 1.6; }

.tags { display: flex; flex-wrap: wrap; gap: 10rpx; }
.tag { font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 20rpx; background: #f5f5f5; color: #666; }

.svc-list { }
.svc-item { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.svc-item:last-child { border-bottom: none; }
.svc-item-info { flex: 1; }
.svc-item-name { font-size: 26rpx; font-weight: 500; color: #333; display: block; }
.svc-item-duration { font-size: 22rpx; color: #999; display: block; margin-top: 4rpx; }
.svc-item-right { display: flex; align-items: center; gap: 12rpx; }
.svc-item-price { font-size: 24rpx; font-weight: bold; color: #1a4731; }
.book-btn { font-size: 22rpx; padding: 8rpx 20rpx; background: #1a4731; color: #ffffff; border-radius: 20rpx; border: none; line-height: 1.2; }

.review-list { }
.review-item { padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.review-item:last-child { border-bottom: none; }
.review-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.review-stars { font-size: 20rpx; }
.review-user { font-size: 22rpx; color: #666; }
.review-time { font-size: 20rpx; color: #bbb; margin-left: auto; }
.review-text { font-size: 24rpx; color: #333; display: block; margin-bottom: 6rpx; }
.review-svc { font-size: 20rpx; color: #999; }

.action-bar { position: fixed; bottom: 0; left: 0; right: 0; background: #ffffff; padding: 16rpx 30rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.06); }
.action-btn { background: #1a4731; color: #ffffff; border-radius: 40rpx; font-size: 30rpx; font-weight: bold; padding: 22rpx 0; border: none; }

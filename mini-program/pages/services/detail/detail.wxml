<!-- pages/services/detail/detail.wxml — 服务商详情 -->
<view class="page">
  <!-- 头部 -->
  <view class="header">
    <view class="header-bg"></view>
    <view class="header-card">
      <view class="svc-icon-wrap"><text class="svc-icon">{{typeIcon}}</text></view>
      <view class="header-info">
        <view class="name-row">
          <text class="svc-name">{{prof.name}}</text>
          <text class="verified-badge" wx:if="{{prof.verified}}">已认证</text>
          <text class="type-badge">{{typeLabel}}</text>
        </view>
        <text class="svc-org" wx:if="{{prof.org_name}}">{{prof.org_name}}</text>
        <text class="svc-qual" wx:if="{{prof.qualification}}">{{prof.qualification}}</text>
        <text class="svc-license" wx:if="{{prof.license_no}}">执业证号：{{prof.license_no}}</text>
      </view>
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="stats-bar">
    <view class="stat-item"><text class="stat-num">⭐ {{prof.rating}}</text><text class="stat-label">综合评分</text></view>
    <view class="stat-item"><text class="stat-num">{{prof.review_count || 0}}</text><text class="stat-label">用户评价</text></view>
    <view class="stat-item"><text class="stat-num">{{prof.order_count || 0}}</text><text class="stat-label">服务次数</text></view>
    <view class="stat-item"><text class="stat-num">{{priceRange}}</text><text class="stat-label">价格范围</text></view>
  </view>

  <!-- 个人简介 -->
  <view class="section" wx:if="{{prof.bio}}">
    <text class="section-title">📝 个人简介</text>
    <text class="section-body">{{prof.bio}}</text>
  </view>

  <!-- 服务区域 -->
  <view class="section" wx:if="{{serviceAreas.length > 0}}">
    <text class="section-title">📍 服务区域</text>
    <view class="tags">
      <text class="tag" wx:for="{{serviceAreas}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <!-- 服务项目 -->
  <view class="section" wx:if="{{services.length > 0}}">
    <text class="section-title">🛎️ 服务项目</text>
    <view class="svc-list">
      <view class="svc-item" wx:for="{{services}}" wx:key="name">
        <view class="svc-item-info">
          <text class="svc-item-name">{{item.name}}</text>
          <text class="svc-item-duration">预计 {{item.duration}}</text>
        </view>
        <view class="svc-item-right">
          <text class="svc-item-price">{{item.price}}</text>
          <button class="book-btn" bind:tap="bookService" data-name="{{item.name}}" data-price="{{item.price}}">预约</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 用户评价 -->
  <view class="section" wx:if="{{reviews.length > 0}}">
    <text class="section-title">💬 用户评价 ({{prof.review_count}})</text>
    <view class="review-list">
      <view class="review-item" wx:for="{{reviews}}" wx:key="id">
        <view class="review-header">
          <text class="review-stars">{{item.stars}}</text>
          <text class="review-user">{{item.user_nickname || '匿名用户'}}</text>
          <text class="review-time">{{item.timeText}}</text>
        </view>
        <text class="review-text">{{item.review_text || '好评'}}</text>
        <text class="review-svc">服务：{{item.service_name}}</text>
      </view>
    </view>
  </view>

  <view style="height:140rpx"></view>

  <!-- 底部操作栏 -->
  <view class="action-bar">
    <button class="action-btn" bind:tap="bookFirstService">📞 预约咨询</button>
  </view>
</view>

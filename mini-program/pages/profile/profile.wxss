/* pages/profile/profile.wxss */
.page { min-height: 100vh; background: #f5f5f5; padding-bottom: 20rpx; }

/* 头部 */
.user-header { position: relative; padding-bottom: 20rpx; }
.user-bg { position: absolute; top: 0; left: 0; right: 0; height: 280rpx; background: linear-gradient(135deg, #1a4731, #2d6a4f); }
.user-card {
  position: relative; display: flex; align-items: center; gap: 24rpx;
  padding: 60rpx 30rpx 30rpx;
}
.avatar {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: rgba(255,255,255,0.2); border: 4rpx solid rgba(255,255,255,0.5);
  display: flex; align-items: center; justify-content: center; overflow: hidden;
}
.avatar-img { width: 100%; height: 100%; }
.avatar-text { font-size: 48rpx; color: #ffffff; font-weight: bold; }
.user-info { flex: 1; }
.nickname { font-size: 36rpx; font-weight: bold; color: #ffffff; display: block; }
.user-role { font-size: 22rpx; color: rgba(255,255,255,0.8); background: rgba(255,255,255,0.15); padding: 4rpx 16rpx; border-radius: 20rpx; margin-top: 8rpx; display: inline-block; }
.login-tip { font-size: 26rpx; color: rgba(255,255,255,0.7); margin-top: 8rpx; }
.settings-btn { width: 60rpx; height: 60rpx; border-radius: 50%; background: rgba(255,255,255,0.15); display: flex; align-items: center; justify-content: center; font-size: 32rpx; }

/* 数据概览 */
.stats-bar {
  display: flex; background: #ffffff; margin: 0 24rpx; border-radius: 20rpx;
  padding: 24rpx 0; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  margin-top: -20rpx; position: relative; z-index: 1;
}
.stat-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6rpx; border-right: 1rpx solid #f0f0f0; }
.stat-item:last-child { border-right: none; }
.stat-num { font-size: 36rpx; font-weight: bold; color: #1a4731; }
.stat-label { font-size: 22rpx; color: #999; }

/* 菜单 */
.menu-section { background: #ffffff; margin: 24rpx; border-radius: 20rpx; overflow: hidden; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.menu-title { font-size: 26rpx; color: #999; padding: 24rpx 24rpx 12rpx; }
.menu-list { }
.menu-item {
  display: flex; align-items: center; padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5; gap: 20rpx;
}
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 36rpx; }
.menu-text { flex: 1; font-size: 28rpx; color: #333; }
.menu-arrow { font-size: 24rpx; color: #ccc; }

/* 退出 */
.logout-btn {
  margin: 40rpx 24rpx; padding: 24rpx; text-align: center;
  background: #ffffff; border-radius: 16rpx; color: #ff4d4f;
  font-size: 28rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

/* 版本 */
.version { text-align: center; font-size: 22rpx; color: #ccc; padding: 20rpx 0 40rpx; }

<!-- pages/profile/profile.wxml — 我的页 -->
<view class="page">
  <!-- 头部用户信息 -->
  <view class="user-header">
    <view class="user-bg"></view>
    <view class="user-card">
      <view class="avatar">
        <image wx:if="{{user.avatar_url}}" class="avatar-img" src="{{user.avatar_url}}" mode="aspectFill" />
        <text wx:else class="avatar-text">{{user.nickname ? user.nickname[0] : '?'}}</text>
      </view>
      <view class="user-info">
        <text class="nickname">{{user.nickname || '未登录'}}</text>
        <text class="user-role" wx:if="{{isLoggedIn}}">{{roleLabel}}{{roleTip}}</text>
        <text class="login-tip" wx:if="{{!isLoggedIn}}" bind:tap="goLogin">点击登录 →</text>
      </view>
      <view class="settings-btn" bind:tap="goSettings" wx:if="{{isLoggedIn}}">
        <text>⚙️</text>
      </view>
    </view>
  </view>

  <!-- 数据概览 -->
  <view class="stats-bar" wx:if="{{isLoggedIn}}">
    <view class="stat-item" bind:tap="goPage" data-url="/pages/asset/publish">
      <text class="stat-num">{{stats.assets || 0}}</text>
      <text class="stat-label">发布</text>
    </view>
    <view class="stat-item" bind:tap="goPage" data-url="/pages/search/search">
      <text class="stat-num">{{stats.favorites || 0}}</text>
      <text class="stat-label">收藏</text>
    </view>
    <view class="stat-item" bind:tap="goPage" data-url="/pages/messages/messages">
      <text class="stat-num">{{stats.appointments || 0}}</text>
      <text class="stat-label">预约</text>
    </view>
    <view class="stat-item" bind:tap="goPage" data-url="/pages/messages/messages">
      <text class="stat-num">{{stats.leads || 0}}</text>
      <text class="stat-label">线索</text>
    </view>
  </view>

  <!-- 快捷操作 -->
  <view class="menu-section">
    <view class="menu-title">我的功能</view>
    <view class="menu-list">
      <view class="menu-item" bind:tap="goPage" data-url="/pages/asset/publish">
        <text class="menu-icon">➕</text>
        <text class="menu-text">发布资产</text>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-item" bind:tap="goMyAssets">
        <text class="menu-icon">🏠</text>
        <text class="menu-text">我的资产</text>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-item" bind:tap="goPage" data-url="/pages/search/search">
        <text class="menu-icon">❤️</text>
        <text class="menu-text">我的收藏</text>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-item" bind:tap="goPage" data-url="/pages/messages/messages">
        <text class="menu-icon">📞</text>
        <text class="menu-text">预约记录</text>
        <text class="menu-arrow">→</text>
      </view>
    </view>
  </view>

  <!-- 其他功能 -->
  <view class="menu-section">
    <view class="menu-title">更多服务</view>
    <view class="menu-list">
      <view class="menu-item" bind:tap="goPage" data-url="/pages/services/index/index">
        <text class="menu-icon">🛡️</text>
        <text class="menu-text">交易服务中心</text>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-item" bind:tap="goPage" data-url="/pages/broker/list/list">
        <text class="menu-icon">🤝</text>
        <text class="menu-text">合伙人</text>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-item" bind:tap="goPage" data-url="/pages/bulk/list/list">
        <text class="menu-icon">🏢</text>
        <text class="menu-text">大宗路演</text>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-item" bind:tap="goPage" data-url="/pages/region/region">
        <text class="menu-icon">📍</text>
        <text class="menu-text">热点寻源</text>
        <text class="menu-arrow">→</text>
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-btn" wx:if="{{isLoggedIn}}" bind:tap="logout">
    退出登录
  </view>

  <!-- 底部版本 -->
  <view class="version">宅基点-乡村闲置资产平台 v1.0.0</view>
</view>

/* pages/messages/messages.wxss */
.page { min-height: 100vh; background: #f5f5f5; }

.tabs {
  display: flex; background: #ffffff; padding: 0 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.tab {
  flex: 1; text-align: center; padding: 24rpx 0; font-size: 26rpx;
  color: #666; position: relative;
}
.tab.active { color: #1a4731; font-weight: bold; }
.tab.active::after {
  content: ''; position: absolute; bottom: 0; left: 25%; right: 25%;
  height: 4rpx; background: #1a4731; border-radius: 2rpx;
}

.msg-list { padding: 16rpx; }

.msg-item {
  display: flex; align-items: center; gap: 20rpx;
  background: #ffffff; border-radius: 16rpx; padding: 24rpx;
  margin-bottom: 12rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.msg-icon-wrap {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  background: #e8f5e9; display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; flex-shrink: 0;
}
.msg-content { flex: 1; min-width: 0; }
.msg-title { font-size: 28rpx; font-weight: 500; color: #333; display: block; }
.msg-desc { font-size: 24rpx; color: #666; display: block; margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.msg-time { font-size: 20rpx; color: #bbb; display: block; margin-top: 6rpx; }
.msg-badge {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: #ff4d4f; color: #ffffff; font-size: 18rpx;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}

.empty { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; color: #999; }

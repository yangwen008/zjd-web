<!-- pages/asset/asset.wxml — 我的资产列表 -->
<view class="page">
  <view class="header">
    <text class="header-title">我的资产</text>
    <view class="add-btn" bind:tap="goPublish">
      <text>➕ 发布</text>
    </view>
  </view>

  <view class="list">
    <view class="empty" wx:if="{{!loading && assets.length === 0}}">
      <text class="empty-icon">🏠</text>
      <text class="empty-text">还没有发布资产</text>
      <button class="empty-btn" bind:tap="goPublish">去发布</button>
    </view>

    <view class="asset-item" wx:for="{{assets}}" wx:key="id" bind:tap="goDetail" data-id="{{item.id}}">
      <image class="item-img" src="{{item.firstImage}}" mode="aspectFill" />
      <view class="item-info">
        <text class="item-title">{{item.title}}</text>
        <text class="item-price">{{item.priceText}}</text>
        <view class="item-meta">
          <text class="item-status {{item.statusClass}}">{{item.statusText}}</text>
          <text class="item-views">👁 {{item.views || 0}}</text>
        </view>
      </view>
    </view>
  </view>
</view>

/* pages/asset/publish.wxss — 完整版 */
.page { min-height: 100vh; background: #f5f5f5; padding-bottom: 40rpx; }

.form-section { background: #ffffff; margin: 20rpx; border-radius: 16rpx; padding: 24rpx; }
.section-title { font-size: 28rpx; font-weight: bold; color: #333; display: block; margin-bottom: 20rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid #f0f0f0; }

.form-item { margin-bottom: 20rpx; }
.form-label { font-size: 24rpx; color: #666; display: block; margin-bottom: 10rpx; }
.form-input { width: 100%; padding: 20rpx; border: 1rpx solid #e0e0e0; border-radius: 12rpx; font-size: 28rpx; box-sizing: border-box; }
.form-textarea { width: 100%; padding: 20rpx; border: 1rpx solid #e0e0e0; border-radius: 12rpx; font-size: 28rpx; height: 160rpx; box-sizing: border-box; }
.form-picker { padding: 20rpx; border: 1rpx solid #e0e0e0; border-radius: 12rpx; font-size: 28rpx; color: #333; }
.form-hint { font-size: 22rpx; color: #bbb; display: block; margin-top: 12rpx; }
.form-row { display: flex; gap: 20rpx; }
.form-item.half { flex: 1; }

.gps-btn { background: #e8f5e9; color: #1a4731; font-size: 26rpx; border-radius: 12rpx; padding: 16rpx 0; border: none; margin-bottom: 12rpx; }

/* 基建/环境网格 */
.infra-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.infra-item {
  display: flex; align-items: center; gap: 8rpx; padding: 12rpx 16rpx;
  background: #f5f5f5; border-radius: 12rpx; min-width: 180rpx;
}
.infra-item .checked { background: #e8f5e9; }
.infra-icon { font-size: 28rpx; }
.infra-label { font-size: 22rpx; color: #333; flex: 1; }
.infra-check {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  border: 2rpx solid #ddd; display: flex; align-items: center; justify-content: center;
  font-size: 20rpx; color: #1a4731;
}
.infra-check.checked { background: #1a4731; border-color: #1a4731; color: #ffffff; }

/* 图片上传 */
.image-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.image-item { position: relative; width: 200rpx; height: 200rpx; border-radius: 12rpx; overflow: hidden; }
.preview-img { width: 100%; height: 100%; }
.remove-img { position: absolute; top: 8rpx; right: 8rpx; width: 40rpx; height: 40rpx; border-radius: 50%; background: rgba(0,0,0,0.5); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 20rpx; }
.image-add { width: 200rpx; height: 200rpx; border-radius: 12rpx; border: 2rpx dashed #ddd; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; }
.add-icon { font-size: 48rpx; color: #ccc; }
.add-text { font-size: 22rpx; color: #ccc; }

/* 提交 */
.submit-area { padding: 40rpx 20rpx; text-align: center; }
.submit-btn { background: #1a4731; color: #ffffff; border-radius: 40rpx; font-size: 32rpx; font-weight: bold; padding: 24rpx 0; border: none; }
.submit-btn[disabled] { background: #a0c4b0; }
.submit-hint { font-size: 22rpx; color: #bbb; display: block; margin-top: 16rpx; }

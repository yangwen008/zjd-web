/* pages/asset/asset.wxss */
.page { min-height: 100vh; background: #f5f5f5; }

.header {
  display: flex; justify-content: space-between; align-items: center;
  background: #ffffff; padding: 24rpx 30rpx; border-bottom: 1rpx solid #f0f0f0;
}
.header-title { font-size: 32rpx; font-weight: bold; color: #333; }
.add-btn {
  background: #1a4731; color: #ffffff; padding: 12rpx 24rpx;
  border-radius: 20rpx; font-size: 24rpx;
}

.list { padding: 20rpx; }

.asset-item {
  display: flex; background: #ffffff; border-radius: 16rpx;
  overflow: hidden; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.item-img { width: 200rpx; height: 160rpx; flex-shrink: 0; }
.item-info { flex: 1; padding: 16rpx 20rpx; display: flex; flex-direction: column; justify-content: space-between; }
.item-title { font-size: 28rpx; font-weight: 500; color: #333; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.item-price { font-size: 28rpx; font-weight: bold; color: #1a4731; }
.item-meta { display: flex; justify-content: space-between; align-items: center; }
.item-status { font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 6rpx; }
.status-green { background: #e8f5e9; color: #2e7d32; }
.status-yellow { background: #fff8e1; color: #e65100; }
.status-red { background: #fce4ec; color: #c62828; }
.item-views { font-size: 20rpx; color: #999; }

.empty { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; color: #999; margin-bottom: 30rpx; }
.empty-btn { background: #1a4731; color: #ffffff; border-radius: 30rpx; font-size: 28rpx; padding: 16rpx 60rpx; border: none; }

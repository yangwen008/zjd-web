/* pages/bulk/detail/detail.wxss */
.page { min-height: 100vh; background: #f5f5f5; }

.media-swiper { width: 100%; height: 500rpx; }
.media-img { width: 100%; height: 100%; }

.info-bar { background: #ffffff; padding: 16rpx 24rpx; display: flex; justify-content: space-between; align-items: center; }
.code { font-size: 24rpx; color: #999; font-family: monospace; }
.cert-tag { font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 6rpx; }
.cert-green { background: #e8f5e9; color: #2e7d32; }
.cert-yellow { background: #fff8e1; color: #e65100; }
.cert-gray { background: #f5f5f5; color: #999; }

.metrics { background: #ffffff; padding: 24rpx; margin-bottom: 16rpx; display: flex; align-items: center; justify-content: space-around; }
.metric-item { display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.metric-value { font-size: 30rpx; font-weight: bold; color: #1a4731; }
.metric-label { font-size: 20rpx; color: #999; }
.metric-divider { width: 1rpx; height: 50rpx; background: #eee; }
.text-green { color: #2e7d32; }

.title-section { background: #ffffff; padding: 20rpx 24rpx; margin-bottom: 16rpx; }
.main-title { font-size: 34rpx; font-weight: bold; color: #1a1a1a; display: block; margin-bottom: 8rpx; }
.sub-title { font-size: 24rpx; color: #666; }

.section { background: #ffffff; padding: 24rpx; margin-bottom: 16rpx; }
.section-title { font-size: 28rpx; font-weight: bold; color: #333; display: block; margin-bottom: 16rpx; }
.section-body { font-size: 26rpx; color: #666; line-height: 1.6; }

.price-section { display: flex; align-items: baseline; gap: 16rpx; }
.price-main { font-size: 36rpx; font-weight: bold; color: #ff4d4f; }
.price-sub { font-size: 24rpx; color: #999; }

.kv-list { }
.kv-item { display: flex; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.kv-item:last-child { border-bottom: none; }
.kv-label { font-size: 24rpx; color: #999; }
.kv-value { font-size: 24rpx; color: #333; font-weight: 500; }

.infra-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.infra-card { width: calc(33.33% - 8rpx); padding: 16rpx 12rpx; border-radius: 12rpx; display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.infra-on { background: #e8f5e9; }
.infra-icon { font-size: 32rpx; }
.infra-label { font-size: 20rpx; color: #333; }
.infra-status { font-size: 18rpx; color: #1a4731; font-weight: 500; }

.mini-map { width: 100%; height: 300rpx; border-radius: 12rpx; }

.invest-section { background: #fffbe6; }
.invest-bar { height: 12rpx; background: #f0f0f0; border-radius: 6rpx; overflow: hidden; margin-bottom: 16rpx; }
.invest-progress { height: 100%; background: linear-gradient(90deg, #1a4731, #4ade80); border-radius: 6rpx; }
.invest-stats { display: flex; justify-content: space-around; margin-bottom: 20rpx; }
.invest-stat { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.invest-num { font-size: 28rpx; font-weight: bold; color: #1a4731; }
.invest-label { font-size: 20rpx; color: #999; }
.invest-btn { background: #1a4731; color: #ffffff; border-radius: 30rpx; font-size: 28rpx; padding: 18rpx 0; border: none; font-weight: bold; }

.action-bar { position: fixed; bottom: 0; left: 0; right: 0; background: #ffffff; padding: 16rpx 24rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); display: flex; align-items: center; gap: 16rpx; box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.06); }
.action-item { display: flex; flex-direction: column; align-items: center; gap: 2rpx; }
.action-icon { font-size: 36rpx; }
.action-text { font-size: 18rpx; color: #666; }
.action-main-btn { flex: 1; background: #1a4731; color: #ffffff; border-radius: 40rpx; font-size: 28rpx; font-weight: bold; padding: 18rpx 0; text-align: center; border: none; }

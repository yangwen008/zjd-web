/* pages/region/region.wxss */
.page { min-height: 100vh; background: #f5f5f5; }

.topbar { background: linear-gradient(135deg, #1a4731, #2d6a4f); padding: 20rpx 30rpx; padding-top: calc(var(--status-bar-height, 44px) + 20rpx); }
.topbar-title { font-size: 34rpx; color: #ffffff; font-weight: bold; }

/* 筛选栏 */
.filter-bar { display: flex; gap: 12rpx; padding: 16rpx 24rpx; background: #ffffff; border-bottom: 1rpx solid #f0f0f0; flex-wrap: wrap; }
.filter-btn { font-size: 24rpx; padding: 10rpx 24rpx; border-radius: 20rpx; background: #f5f5f5; color: #666; }
.filter-btn.active { background: #1a4731; color: #ffffff; }
.province-btn { margin-left: auto; }

/* 省份筛选弹窗 */
.province-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: flex-start; }
.province-panel { width: 100%; max-height: 60vh; background: #ffffff; border-radius: 0 0 32rpx 32rpx; padding-bottom: 20rpx; }
.province-header { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 30rpx; border-bottom: 1rpx solid #f0f0f0; }
.province-title { font-size: 30rpx; font-weight: bold; color: #333; }
.province-clear { font-size: 24rpx; color: #ff4d4f; }
.province-grid { display: flex; flex-wrap: wrap; padding: 16rpx; gap: 12rpx; }
.province-item {
  width: calc(20% - 10rpx); padding: 16rpx 0; display: flex; align-items: center; justify-content: center;
  border-radius: 12rpx; background: #f5f5f5; font-size: 22rpx; color: #333;
}
.province-item.active { background: #e8f5e9; border: 2rpx solid #1a4731; color: #1a4731; font-weight: bold; }

/* 瀑布流 */
.waterfall { display: flex; gap: 16rpx; padding: 20rpx; }
.waterfall-col { flex: 1; display: flex; flex-direction: column; }

.asset-card { background: #ffffff; border-radius: 16rpx; overflow: hidden; margin-bottom: 16rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05); }
.card-image { position: relative; width: 100%; height: 0; padding-bottom: 56%; }
.card-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.card-overlay { position: absolute; bottom: 0; left: 0; right: 0; padding: 8rpx 12rpx; background: linear-gradient(transparent, rgba(0,0,0,0.55)); display: flex; align-items: center; gap: 4rpx; }
.overlay-type { font-size: 20rpx; color: #ffffff; font-weight: 500; }
.card-body { padding: 14rpx 16rpx 16rpx; }
.card-title { font-size: 26rpx; font-weight: bold; color: #1a1a1a; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.35; margin-bottom: 6rpx; }
.card-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-bottom: 8rpx; }
.tag { font-size: 18rpx; padding: 2rpx 10rpx; border-radius: 6rpx; background: #f5f5f5; color: #666; }
.card-bottom { display: flex; justify-content: space-between; align-items: baseline; }
.card-price { font-size: 28rpx; font-weight: bold; color: #ff4d4f; }
.card-views { font-size: 20rpx; color: #bbb; }

.loading, .empty { text-align: center; padding: 60rpx; color: #999; font-size: 26rpx; }
.empty-icon { font-size: 60rpx; display: block; margin-bottom: 12rpx; }
.empty-text { display: block; }
.no-more { text-align: center; padding: 20rpx; color: #ccc; font-size: 24rpx; }

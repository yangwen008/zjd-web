/* pages/region/region.wxss */
.page { min-height: 100vh; background: #f5f5f5; }

.topbar { background: linear-gradient(135deg, #1a4731, #2d6a4f); padding: 20rpx 30rpx; padding-top: calc(var(--status-bar-height, 44px) + 20rpx); }
.topbar-title { font-size: 34rpx; color: #ffffff; font-weight: bold; }

/* 省份网格 */
.province-grid { display: flex; flex-wrap: wrap; padding: 16rpx; gap: 12rpx; background: #ffffff; margin-bottom: 16rpx; }
.province-item {
  width: calc(20% - 10rpx); padding: 16rpx 0; display: flex; flex-direction: column;
  align-items: center; gap: 4rpx; border-radius: 12rpx; background: #f5f5f5;
}
.province-item.active { background: #e8f5e9; border: 2rpx solid #1a4731; }
.province-emoji { font-size: 32rpx; }
.province-name { font-size: 20rpx; color: #333; }
.province-count { font-size: 18rpx; color: #999; }

/* 资产列表 */
.section { background: #ffffff; padding: 20rpx; margin-bottom: 16rpx; }
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.section-title { font-size: 28rpx; font-weight: bold; color: #333; }
.section-more { font-size: 24rpx; color: #1a4731; }

.waterfall { display: flex; gap: 12rpx; }
.waterfall-col { flex: 1; display: flex; flex-direction: column; }

.asset-card { background: #ffffff; border-radius: 12rpx; overflow: hidden; margin-bottom: 12rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05); border: 1rpx solid #f0f0f0; }
.card-image { position: relative; width: 100%; height: 0; padding-bottom: 56%; }
.card-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.card-overlay { position: absolute; bottom: 0; left: 0; right: 0; padding: 6rpx 10rpx; background: linear-gradient(transparent, rgba(0,0,0,0.5)); }
.overlay-type { font-size: 18rpx; color: #ffffff; }
.card-body { padding: 10rpx 12rpx 12rpx; }
.card-title { font-size: 24rpx; font-weight: 500; color: #333; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: 6rpx; }
.card-bottom { display: flex; justify-content: space-between; align-items: baseline; }
.card-price { font-size: 24rpx; font-weight: bold; color: #ff4d4f; }
.card-views { font-size: 18rpx; color: #bbb; }

.loading, .empty { text-align: center; padding: 40rpx; color: #999; font-size: 26rpx; }

<!-- pages/region/region.wxml — 热点寻源 -->
<view class="page">
  <view class="topbar">
    <text class="topbar-title">📍 热点寻源</text>
  </view>

  <!-- 省份网格 -->
  <view class="province-grid">
    <view class="province-item {{item.active ? 'active' : ''}}" wx:for="{{provinces}}" wx:key="name" bind:tap="selectProvince" data-name="{{item.name}}">
      <text class="province-emoji">{{item.emoji}}</text>
      <text class="province-name">{{item.name}}</text>
      <text class="province-count">{{item.count}}宗</text>
    </view>
  </view>

  <!-- 选中省份的资产列表 -->
  <view class="section" wx:if="{{selectedProvince}}">
    <view class="section-header">
      <text class="section-title">{{selectedProvince}} 的资产</text>
      <text class="section-more" bind:tap="goSearch">查看全部 →</text>
    </view>
    <view class="waterfall">
      <view class="waterfall-col">
        <view class="asset-card" wx:for="{{leftCol}}" wx:key="id" bind:tap="goAsset" data-id="{{item.id}}">
          <view class="card-image">
            <image class="card-img" src="{{item.firstImage}}" mode="aspectFill" />
            <view class="card-overlay">
              <text class="overlay-type">{{item.asset_type || '资产'}}</text>
            </view>
          </view>
          <view class="card-body">
            <text class="card-title">{{item.title}}</text>
            <view class="card-bottom">
              <text class="card-price">{{item.priceText}}</text>
              <text class="card-views">👁 {{item.views || 0}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="waterfall-col">
        <view class="asset-card" wx:for="{{rightCol}}" wx:key="id" bind:tap="goAsset" data-id="{{item.id}}">
          <view class="card-image">
            <image class="card-img" src="{{item.firstImage}}" mode="aspectFill" />
            <view class="card-overlay">
              <text class="overlay-type">{{item.asset_type || '资产'}}</text>
            </view>
          </view>
          <view class="card-body">
            <text class="card-title">{{item.title}}</text>
            <view class="card-bottom">
              <text class="card-price">{{item.priceText}}</text>
              <text class="card-views">👁 {{item.views || 0}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="loading" wx:if="{{loadingAssets}}">加载中...</view>
    <view class="empty" wx:if="{{!loadingAssets && assets.length === 0}}">
      <text class="empty-text">该省份暂无资产</text>
    </view>
  </view>
</view>

<!-- pages/index/index.wxml — 首页（美团风格双列瀑布流） -->
<import src="../../components/asset-card.wxml" />

<view class="page">
  <!-- 顶栏 -->
  <view class="topbar">
    <view class="topbar-location" bind:tap="chooseCity">
      <text class="location-icon">📍</text>
      <text class="location-text">{{locationText}}</text>
      <text class="location-arrow">▼</text>
    </view>
    <view class="topbar-search" bind:tap="goSearch">
      <text class="search-icon">🔍</text>
      <text class="search-placeholder">搜索资产、地点、类型...</text>
    </view>
  </view>

  <!-- 城市选择弹窗 -->
  <view class="city-overlay" wx:if="{{showCityPicker}}" bind:tap="closeCityPicker">
    <view class="city-picker" catch:tap="noop">
      <view class="city-header">
        <text class="city-title">选择城市</text>
        <text class="city-close" bind:tap="closeCityPicker">✕</text>
      </view>
      <!-- 省份列表 -->
      <view wx:if="{{!selectedCity}}">
        <scroll-view scroll-y class="city-list">
          <view class="city-item" wx:for="{{provinces}}" wx:key="name" bind:tap="showCities" data-name="{{item.name}}">
            <text>{{item.emoji || '📍'}} {{item.name}}</text>
            <text class="city-arrow">→</text>
          </view>
        </scroll-view>
      </view>
      <!-- 城市列表 -->
      <view wx:else>
        <view class="city-back" bind:tap="selectCity" data-name="">
          <text>← 返回省份</text>
        </view>
        <scroll-view scroll-y class="city-list">
          <view class="city-item" wx:for="{{cities}}" wx:key="name" bind:tap="selectCity" data-name="{{item.name}}">
            <text>{{item.name}}</text>
          </view>
        </scroll-view>
      </view>
    </view>
  </view>

  <!-- 金刚区 -->
  <view class="kingkong">
    <!-- 第一行：资产类型（横向滚动） -->
    <scroll-view scroll-x class="kingkong-scroll">
      <view class="kingkong-row">
        <view class="kingkong-item" wx:for="{{assetTypes}}" wx:key="type" bind:tap="goFilter" data-type="{{item.type}}">
          <view class="kingkong-icon" style="background:{{item.bg}}">
            <text>{{item.icon}}</text>
          </view>
          <text class="kingkong-label">{{item.label}}</text>
        </view>
      </view>
    </scroll-view>
    <!-- 第二行：服务入口 -->
    <view class="kingkong-row-fixed">
      <view class="kingkong-item" wx:for="{{serviceEntries}}" wx:key="path" bind:tap="goPage" data-url="{{item.path}}">
        <view class="kingkong-icon" style="background:{{item.bg}}">
          <text>{{item.icon}}</text>
        </view>
        <text class="kingkong-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 附近资产（双列瀑布流） -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">📍 附近资产</text>
      <text class="section-more" bind:tap="goSearch">查看全部 →</text>
    </view>
    <view class="waterfall">
      <view class="waterfall-col">
        <template is="assetCard" wx:for="{{leftCol}}" wx:key="id" data="{{...item}}" />
      </view>
      <view class="waterfall-col">
        <template is="assetCard" wx:for="{{rightCol}}" wx:key="id" data="{{...item}}" />
      </view>
    </view>
    <view class="loading" wx:if="{{loading}}">加载中...</view>
    <view class="empty" wx:if="{{!loading && assets.length === 0}}">
      <text class="empty-icon">🏘️</text>
      <text class="empty-text">暂无资产</text>
    </view>
    <view class="no-more" wx:if="{{!loading && noMore}}">没有更多了</view>
  </view>
</view>

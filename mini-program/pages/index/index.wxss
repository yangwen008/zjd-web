/* pages/index/index.wxss — 美团风格双列瀑布流 */
.page { min-height: 100vh; background: #f5f5f5; padding-bottom: 20rpx; }

/* 顶栏 */
.topbar {
  background: linear-gradient(135deg, #1a4731, #2d6a4f);
  padding: 20rpx 30rpx;
  padding-top: calc(var(--status-bar-height, 44px) + 20rpx);
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.topbar-location { display: flex; align-items: center; gap: 6rpx; }
.location-icon { font-size: 28rpx; }
.location-text { font-size: 28rpx; color: #ffffff; font-weight: 500; }
.location-arrow { font-size: 18rpx; color: rgba(255,255,255,0.7); }
.topbar-search {
  flex: 1; background: rgba(255,255,255,0.2); border-radius: 32rpx;
  padding: 14rpx 24rpx; display: flex; align-items: center; gap: 12rpx;
}
.search-icon { font-size: 28rpx; }
.search-placeholder { font-size: 24rpx; color: rgba(255,255,255,0.7); }

/* 金刚区（横向滚动） */
.kingkong { background: #ffffff; padding: 24rpx 0 20rpx; margin-bottom: 20rpx; }
.kingkong-scroll { white-space: nowrap; }
.kingkong-row { display: inline-flex; align-items: center; padding: 0 20rpx; gap: 0; }
.kingkong-item { display: inline-flex; flex-direction: column; align-items: center; gap: 8rpx; width: 110rpx; flex-shrink: 0; }
.kingkong-icon {
  width: 90rpx; height: 90rpx; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center; font-size: 40rpx;
}
.kingkong-label { font-size: 20rpx; color: #333333; white-space: nowrap; }
.kingkong-divider { width: 1rpx; height: 60rpx; background: #f0f0f0; margin: 0 8rpx; flex-shrink: 0; }

/* 城市选择弹窗 */
.city-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: flex-end; }
.city-picker { width: 100%; max-height: 70vh; background: #ffffff; border-radius: 32rpx 32rpx 0 0; }
.city-header { display: flex; justify-content: space-between; align-items: center; padding: 30rpx; border-bottom: 1rpx solid #f0f0f0; }
.city-title { font-size: 32rpx; font-weight: bold; color: #333; }
.city-close { font-size: 36rpx; color: #999; padding: 10rpx; }
.city-list { max-height: 60vh; padding: 0 30rpx; }
.city-item { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #f5f5f5; font-size: 28rpx; color: #333; }
.city-arrow { color: #ccc; font-size: 24rpx; }
.city-back { padding: 24rpx 30rpx; color: #1a4731; font-size: 26rpx; border-bottom: 1rpx solid #f0f0f0; }

/* 推荐轮播 */
.section { background: #ffffff; padding: 30rpx; margin-bottom: 20rpx; }
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.section-title { font-size: 32rpx; font-weight: bold; color: #333333; }
.section-more { font-size: 24rpx; color: #1a4731; }
.featured-scroll { white-space: nowrap; }
.featured-card {
  display: inline-block; width: 400rpx; height: 240rpx;
  border-radius: 16rpx; overflow: hidden; margin-right: 20rpx; position: relative;
}
.featured-img { width: 100%; height: 100%; }
.featured-overlay {
  position: absolute; bottom: 0; left: 0; right: 0;
  padding: 20rpx; background: linear-gradient(transparent, rgba(0,0,0,0.7));
}
.featured-title { font-size: 26rpx; color: #ffffff; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.featured-price { font-size: 28rpx; color: #ff4d4f; font-weight: bold; }

/* 双列瀑布流 */
.waterfall {
  display: flex;
  gap: 16rpx;
}
.waterfall-col {
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* 资产卡片（纵向） */
.asset-card {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  margin-bottom: 20rpx;
}
.card-image { position: relative; width: 100%; height: 0; padding-bottom: 56%; }
.card-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.card-overlay {
  position: absolute; bottom: 0; left: 0; right: 0;
  padding: 8rpx 12rpx; background: linear-gradient(transparent, rgba(0,0,0,0.55));
  display: flex; align-items: center; gap: 4rpx;
}
.overlay-type { font-size: 20rpx; color: #ffffff; font-weight: 500; }
.overlay-dot { font-size: 20rpx; color: rgba(255,255,255,0.7); }
.overlay-dist { font-size: 20rpx; color: rgba(255,255,255,0.85); }
.card-body { padding: 14rpx 16rpx 16rpx; }
.card-title {
  font-size: 26rpx; font-weight: bold; color: #1a1a1a;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  overflow: hidden; line-height: 1.35; margin-bottom: 6rpx;
}
.card-desc {
  font-size: 22rpx; color: #999999;
  display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical;
  overflow: hidden; margin-bottom: 8rpx;
}
.card-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-bottom: 10rpx; }
.tag { font-size: 18rpx; padding: 2rpx 10rpx; border-radius: 6rpx; background: #f5f5f5; color: #666666; }
.tag-lease { background: #e8f5e9; color: #2e7d32; }
.tag-cert { background: #e3f2fd; color: #1565c0; }
.card-bottom { display: flex; justify-content: space-between; align-items: baseline; }
.card-price { font-size: 30rpx; font-weight: bold; color: #ff4d4f; }
.card-views { font-size: 20rpx; color: #bbbbbb; }

/* 状态 */
.loading, .empty, .no-more { text-align: center; padding: 40rpx; color: #999999; font-size: 26rpx; }
.empty-icon { font-size: 60rpx; display: block; margin-bottom: 16rpx; }

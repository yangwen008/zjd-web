/* pages/index/index.wxss */
.page { min-height: 100vh; background: #f5f5f5; padding-bottom: 140rpx; }

/* 顶栏 */
.topbar {
  background: linear-gradient(135deg, #1a4731, #2d6a4f);
  padding: 20rpx 30rpx;
  padding-top: calc(var(--status-bar-height, 44px) + 20rpx);
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.topbar-location { display: flex; align-items: center; gap: 6rpx; }
.location-icon { font-size: 28rpx; }
.location-text { font-size: 28rpx; color: #ffffff; font-weight: 500; }
.location-arrow { font-size: 18rpx; color: rgba(255,255,255,0.7); }

.topbar-search {
  flex: 1;
  background: rgba(255,255,255,0.2);
  border-radius: 32rpx;
  padding: 14rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.search-icon { font-size: 28rpx; }
.search-placeholder { font-size: 24rpx; color: rgba(255,255,255,0.7); }

/* 金刚区 */
.kingkong { background: #ffffff; padding: 30rpx 20rpx 20rpx; margin-bottom: 20rpx; }
.kingkong-row { display: flex; justify-content: space-around; margin-bottom: 20rpx; }
.kingkong-item { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.kingkong-icon {
  width: 90rpx; height: 90rpx; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center; font-size: 40rpx;
}
.kingkong-label { font-size: 22rpx; color: #333333; }

/* 推荐轮播 */
.section { background: #ffffff; padding: 30rpx; margin-bottom: 20rpx; }
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.section-title { font-size: 32rpx; font-weight: bold; color: #333333; }
.section-more { font-size: 24rpx; color: #1a4731; }

.featured-scroll { white-space: nowrap; }
.featured-card {
  display: inline-block; width: 400rpx; height: 240rpx;
  border-radius: 16rpx; overflow: hidden; margin-right: 20rpx; position: relative;
}
.featured-img { width: 100%; height: 100%; }
.featured-overlay {
  position: absolute; bottom: 0; left: 0; right: 0;
  padding: 20rpx; background: linear-gradient(transparent, rgba(0,0,0,0.7));
}
.featured-title { font-size: 26rpx; color: #ffffff; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.featured-price { font-size: 28rpx; color: #4ade80; font-weight: bold; }

/* 资产卡片 */
.asset-card {
  background: #ffffff; border-radius: 20rpx; overflow: hidden;
  margin-bottom: 24rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.card-image { position: relative; width: 100%; height: 0; padding-bottom: 60%; }
.card-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.card-badges { position: absolute; bottom: 16rpx; left: 16rpx; display: flex; gap: 8rpx; }
.badge { font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 8rpx; color: #ffffff; }
.badge-official { background: rgba(26,71,49,0.85); }
.badge-village { background: rgba(220,53,69,0.85); }
.badge-exchange { background: rgba(255,193,7,0.85); color: #333; }
.badge-third { background: rgba(108,117,125,0.85); }
.badge-personal { background: rgba(0,0,0,0.5); }

.card-info { padding: 20rpx 24rpx; }
.card-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx; }
.card-price { font-size: 34rpx; font-weight: bold; color: #1a4731; }
.card-lease { font-size: 24rpx; color: #999999; }
.card-field { font-size: 24rpx; color: #666666; }
.card-location { font-size: 22rpx; color: #999999; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.card-distance { font-size: 22rpx; color: #1a73e8; margin-left: 16rpx; }

/* 状态 */
.loading, .empty, .no-more { text-align: center; padding: 40rpx; color: #999999; font-size: 26rpx; }
.empty-icon { font-size: 60rpx; display: block; margin-bottom: 16rpx; }
.empty-text { display: block; }

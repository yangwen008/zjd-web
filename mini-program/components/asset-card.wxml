<!-- components/asset-card.wxml — 资产卡片（美团风格：纵向卡片+双列瀑布流） -->
<template name="assetCard">
  <view class="asset-card" bind:tap="goAsset" data-id="{{id}}">
    <!-- 图片区 -->
    <view class="card-image">
      <image class="card-img" src="{{firstImage || '/static/logo.png'}}" mode="aspectFill" />
      <!-- 左下角叠加：资产类型 + 距离 -->
      <view class="card-overlay">
        <text class="overlay-type">{{asset_type || '资产'}}</text>
        <text class="overlay-dot">·</text>
        <text class="overlay-dist" wx:if="{{distanceText}}">距您{{distanceText}}</text>
      </view>
    </view>

    <!-- 信息区 -->
    <view class="card-body">
      <!-- 标题 -->
      <text class="card-title">{{title}}</text>
      <!-- 简介（可选） -->
      <text class="card-desc" wx:if="{{descText}}">{{descText}}</text>
      <!-- 标签行 -->
      <view class="card-tags">
        <text class="tag" wx:if="{{badge}}">{{badge}}</text>
        <text class="tag" style="color:{{transferColor}}" wx:if="{{transferLabel}}">{{transferLabel}}</text>
        <text class="tag tag-lease" wx:if="{{lease_years}}">{{lease_years}}年</text>
        <text class="tag tag-cert" wx:if="{{certification === 'certified'}}">已确权</text>
      </view>
      <!-- 价格 + 浏览量 -->
      <view class="card-bottom">
        <text class="card-price">{{priceText}}</text>
        <text class="card-views" wx:if="{{viewsText}}">{{viewsText}}</text>
      </view>
    </view>
  </view>
</template>

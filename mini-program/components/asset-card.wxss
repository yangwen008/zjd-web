/* components/asset-card.wxss — 美团风格纵向卡片 */
.asset-card {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  break-inside: avoid;
  margin-bottom: 20rpx;
}

/* 图片区 */
.card-image {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 56%;
}

.card-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 左下角叠加标签 */
.card-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 8rpx 12rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.55));
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.overlay-type {
  font-size: 20rpx;
  color: #ffffff;
  font-weight: 500;
}

.overlay-dot {
  font-size: 20rpx;
  color: rgba(255,255,255,0.7);
}

.overlay-dist {
  font-size: 20rpx;
  color: rgba(255,255,255,0.85);
}

/* 信息区 */
.card-body {
  padding: 14rpx 16rpx 16rpx;
}

.card-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #1a1a1a;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.35;
  margin-bottom: 6rpx;
}

.card-desc {
  font-size: 22rpx;
  color: #999999;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 8rpx;
}

/* 标签行 */
.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.tag {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #f5f5f5;
  color: #666666;
}

.tag-lease {
  background: #e8f5e9;
  color: #2e7d32;
}

.tag-cert {
  background: #e3f2fd;
  color: #1565c0;
}

/* 价格 + 浏览量 */
.card-bottom {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.card-price {
  font-size: 30rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.card-views {
  font-size: 20rpx;
  color: #bbbbbb;
}
